/dts-v1/;

// For zephyr 3.7
#include <microchip/mec172xnsz.dtsi>
#include <microchip/mec172x/mec172xnsz-pinctrl.dtsi>
// For zephyr 3.7 end

// #include <microchip/mec/mec172xnsz.dtsi>
// #include <microchip/mec/mec172x/mec172xnsz-pinctrl.dtsi>

#include <dt-bindings/pwm/pwm.h>

/ {
	model = "Microchip Qualcomm Module";
	compatible = "microchip,qual_module-mec172x_nsz";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	aliases {
		cpu-fan = &fan0;
		cpu-tach = &tach1;
		base-fan = &fan1;
		base-tach = &tach0;

		aoss-i2c = &i2c_smb_0;
        acpi-i2c = &i2c_smb_1;
        sen-i2c = &i2c_smb_2;
	};

	zephyr,user {
        acpi-int-gpios = <MCHP_GPIO_DECODE_226 GPIO_ACTIVE_HIGH>;
        sen-int-gpios = <MCHP_GPIO_DECODE_157 GPIO_ACTIVE_HIGH>;

        board-id0-gpios = <MCHP_GPIO_DECODE_204 GPIO_ACTIVE_HIGH>;
        board-id1-gpios = <MCHP_GPIO_DECODE_205 GPIO_ACTIVE_HIGH>;

        io-channels =  <&adc0 0>, <&adc0 1>, <&adc0 2>;

        thro-mira-gpios = <MCHP_GPIO_DECODE_164 GPIO_ACTIVE_HIGH>;
        wk-en-gpios = <MCHP_GPIO_DECODE_221 GPIO_ACTIVE_HIGH>;
        slp-indicator-gpios = <MCHP_GPIO_DECODE_011 GPIO_ACTIVE_HIGH>;
        soc-rev-gpios = <MCHP_GPIO_DECODE_203 GPIO_ACTIVE_HIGH>;
        resout-3p3-gpios = <MCHP_GPIO_DECODE_244 GPIO_ACTIVE_HIGH>;
        misc-1p8-gpios = <MCHP_GPIO_DECODE_240 GPIO_ACTIVE_HIGH>;
        ec-psl-gpios = <MCHP_GPIO_DECODE_243 GPIO_ACTIVE_HIGH>;
        soc-pwr-status-gpios = <MCHP_GPIO_DECODE_242 GPIO_ACTIVE_HIGH>;

		fan-max-rpm-gpios = <MCHP_GPIO_DECODE_206 GPIO_ACTIVE_HIGH>;
        fan-12v-enable-gpios = <MCHP_GPIO_DECODE_242 GPIO_ACTIVE_HIGH>;
    };

	soc {
        pwm9: pwm@40005890 {
			compatible = "microchip,xec-pwm";
			reg = < 0x40005890 0x20 >;
			pcrs = < 0x1 0x1f >;
			status = "disabled";
			#pwm-cells = < 0x3 >;
		};
    };

	/delete-node/ memory@118000;
	sram0: memory@118000 {
		compatible = "mmio-sram";
		// reg = <0x00118000 0xf800>;
		reg = <0x00118000 0xf000>;
	};

	retained_mem: memory@127000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x00127000 0x800>;
	};

	pwmfans {
		compatible = "pwm-leds";
		fan0: fan0 {
			pwms = <&pwm8 0 PWM_USEC(40) PWM_POLARITY_NORMAL>;
		};
		fan1: fan1 {
			pwms = <&pwm9 0 PWM_USEC(40) PWM_POLARITY_NORMAL>;
		};
	};
};

&idle {
	min-residency-us = <100000>;
};

&suspend_to_ram {
	min-residency-us = <200000>;
};

&retained_mem {
	status = "okay";
	zephyr,memory-region = "retained";

	retainedmem {
		compatible = "zephyr,retained-ram";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_info0: boot_info@0 {
			compatible = "zephyr,retention";
			status = "okay";
			reg = <0x0 0x400>;

            prefix = [08 04];
			checksum = <1>;
		};

		sys_info0: sys_info@400 {
			compatible = "zephyr,retention";
			status = "okay";
			reg = <0x400 0x400>;
		};
	};
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        boot_partition: partition@0 {
            label = "bootloader";
            reg = <0x00000 DT_SIZE_K(64)>;
        };
        app_partition: partition@10000 {
            label = "app";
            // reg = <0x10000 0x58000>;
            reg = <0x10000 DT_SIZE_K(200)>;
        };
    };
};

/* Disable ARM SysTick kernel timer driver */
&systick {
	status = "disabled";
};

/* Enable MCHP kernel timer driver using 32KHz RTOS timer and 1MHz basic timer */
&rtimer {
	status = "okay";
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
	pinctrl-0 = < &uart0_tx_gpio104 &uart0_rx_gpio105 >;
	pinctrl-names = "default";
};

&i2c_smb_0 {
    status = "okay";
    port_sel = <2>;
    pinctrl-0 = < &i2c02_sda_gpio154 &i2c02_scl_gpio155 >;
	pinctrl-names = "default";
    
    label = "aoss_i2c";

    aoss: aoss@35 {
        compatible = "vnd,i2c-device";
        reg = < 0x35 >;
    };
};

&i2c_smb_1 {
    status = "okay";
    port_sel = <7>;
    pinctrl-0 = < &i2c07_sda_gpio012 &i2c07_scl_gpio013 >;
	pinctrl-names = "default";

    label = "acpi_i2c";
};

&i2c_smb_2 {
    status = "okay";
    port_sel = <1>;
    pinctrl-0 = < &i2c01_sda_gpio130 &i2c01_scl_gpio131 >;
	pinctrl-names = "default";

    label = "sen_i2c";
};

&adc0 {
	#address-cells = <1>;
	#size-cells = <0>;

    status = "okay";
    pinctrl-0 = < &adc00_gpio200 &adc01_gpio201 &adc02_gpio202 &adc04_gpio204 &adc05_gpio205 >;
	pinctrl-names = "default";

    channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
	};
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
	};
	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
	};
    channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
	};
    channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
	};
};

&spi0 {
    compatible = "microchip,xec-qmspi-ldma";
    status = "okay";
    // port-sel = <1>;
    clock-frequency = <DT_FREQ_M(8)>;

    // // For external flash
    // chip-select = < 0x0 >;
    // pinctrl-0 = < &shd_io0_gpio223 
    //               &shd_io1_gpio224
    //               &shd_clk_gpio056
    //               &shd_cs0_n_gpio055 >;
    // gd25lb256: gd25lb256@0 {
	// 	compatible = "jedec,spi-nor";
	// 	size = <DT_SIZE_M(32)>;
	// 	reg = <0>;
	// 	spi-max-frequency = <DT_FREQ_M(8)>;
	// 	jedec-id = [c8 67 19];
	// 	status = "okay";
	// };

    // For internal flash
    pinctrl-0 = < &int_spi_io0_gpio251 
                  &int_spi_io1_gpio252
                  &int_spi_clk_gpio257
                  &int_spi_cs_n_gpio256
                  &int_spi_wp_gpio260 >;
    int_flash: sst25pf040@0 {
        compatible ="jedec,spi-nor";
        size = <DT_SIZE_M(4)>; // 4M bits (512K Bytes)
        label = "SST25PF040";
        reg = <0>;
        spi-max-frequency = <DT_FREQ_M(8)>; // DT_FREQ_M(40)
        status = "okay";
        jedec-id = [62 06 13];
    };

    pinctrl-names = "default";
};

&int_flash {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        tag_partition: partition@0 {
            label = "tag";
            reg = <0x00000 0x08>;
        };

        bl_partition: partition@1000 {
            label = "boot";
            reg = <0x1000 DT_SIZE_K(64)>;
        };

        hdr_partition: partition@11000 {
            label = "header";
            reg = <0x11000 0x20>;
        };

        img_partition: partition@11020 {
            label = "image";
            // reg = <0x11020 0x58000>;
            reg = <0x11020 0x31FE0>; // 200KB - 20B
        };
    };
};

// Base Fan
&pwm8 {
    status = "okay";
    pinctrl-0 = < &pwm8_gpio035 >;
    pinctrl-names = "default";
};

&tach1 {
    status = "okay";
    pinctrl-0 = < &tach1_gpio051 >;
    pinctrl-names = "default";
};
// Base Fan end

// CPU Fan
&pwm9 {
    status = "okay";
    pinctrl-0 = < &pwm9_gpio133 >;
    pinctrl-names = "default";
};

&tach0 {
    status = "okay";
    pinctrl-0 = < &tach0_gpio050 >;
    pinctrl-names = "default";
};
// CPU Fan end

&pinctrl{
    /* Internal flash */
    /omit-if-no-ref/ int_spi_cs_n_gpio256: int_spi_cs_n_gpio256 {
        pinmux = < MCHP_XEC_PINMUX(0256, MCHP_AF1) >;
    };

    /omit-if-no-ref/ int_spi_clk_gpio257: int_spi_clk_gpio257 {
        pinmux = < MCHP_XEC_PINMUX(0257, MCHP_AF1) >;
    };

    /omit-if-no-ref/ int_spi_io0_gpio251: int_spi_io0_gpio251 {
        pinmux = < MCHP_XEC_PINMUX(0251, MCHP_AF1) >;
    };

    /omit-if-no-ref/ int_spi_io1_gpio252: int_spi_io1_gpio252 {
        pinmux = < MCHP_XEC_PINMUX(0252, MCHP_AF1) >;
    };

    /omit-if-no-ref/ int_spi_wp_gpio260: int_spi_wp_gpio260 {
        pinmux = < MCHP_XEC_PINMUX(0260, MCHP_AF0) >;
    };

	/* PWM */
	/omit-if-no-ref/ pwm9_gpio133: pwm9_gpio133 {
		pinmux = < MCHP_XEC_PINMUX(0133, MCHP_AF1) >;
	};
};
